{
  "name": "agentsdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://agentsdeck.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hirukadeven07/AgentsDeck.git"
  },
  "bugs": {
    "url": "https://github.com/Hirukadeven07/AgentsDeck/issues"
  },
  "description": "See what your AI agents are doing: an architectural model of an office where agents walk to stations, plus a skills layer and a team roster.",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
