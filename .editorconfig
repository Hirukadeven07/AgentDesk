# Keeps editors on the repo's style: 2-space indent, LF line endings, UTF-8.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false
